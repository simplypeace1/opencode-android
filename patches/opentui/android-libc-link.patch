diff --git a/packages/core/src/zig/build.zig b/packages/core/src/zig/build.zig
index ed85ddf..623d05e 100644
--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -367,7 +367,11 @@ fn addNativeAudioDependencies(
         .macos => addMacOSSystemLibraries(b, module, macos_sdk_path.?),
         .linux => {
             module.linkSystemLibrary("dl", .{});
-            module.linkSystemLibrary("pthread", .{});
+            // Android's bionic merges pthreads into libc; there is no
+            // libpthread.so in the NDK r28b sysroot, so skip -lpthread.
+            if (target.result.abi != .android and target.result.abi != .androideabi) {
+                module.linkSystemLibrary("pthread", .{});
+            }
             module.linkSystemLibrary("m", .{});
         },
         else => {},
@@ -731,6 +735,57 @@ fn buildTarget(
         .linkage = .dynamic,
     });
 
+    // On Android, the .so must have NEEDED libc.so so dlopen can resolve
+    // symbols like getauxval. Zig doesn't bundle Android libc, so we directly
+    // add the NDK sysroot's libc.so stub as a link input.
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        const arch_dir: ?[]const u8 = switch (target.result.cpu.arch) {
+            .aarch64 => "aarch64-linux-android",
+            .arm => "arm-linux-androideabi",
+            .x86 => "i686-linux-android",
+            .x86_64 => "x86_64-linux-android",
+            else => null,
+        };
+        if (arch_dir) |dir_name| {
+            const ndk_lib: ?[]const u8 = blk: {
+                if (b.graph.environ_map.get("ANDROID_NDK_LIB_DIR")) |dir| {
+                    break :blk dir;
+                }
+                if (b.graph.environ_map.get("ANDROID_NDK_HOME")) |ndk_home| {
+                    break :blk std.fmt.allocPrint(
+                        b.allocator,
+                        "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/{s}/24",
+                        .{ ndk_home, dir_name },
+                    ) catch null;
+                }
+                break :blk null;
+            };
+            if (ndk_lib) |dir| {
+                // Directly add the libc.so stub as an object-file link input so
+                // it is linked (DT_NEEDED) without triggering Zig's native
+                // libc provisioning.
+                const libc_path = std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{dir}) catch unreachable;
+                lib.root_module.addObjectFile(.{ .cwd_relative = libc_path });
+                // Add the NDK triple lib dir to the system library search
+                // paths so -ldl/-lpthread/-lm resolve to the bionic stubs
+                // (libdl.so/libpthread.so/libm.so) in the sysroot. The libc
+                // file's crt_dir is only used for CRT objects, not -l lookups.
+                lib.root_module.addLibraryPath(.{ .cwd_relative = dir });
+            }
+        }
+
+        // Pass the bionic libc paths file to ONLY this cross-compiled library
+        // via setLibCFile, so the linker can find crt_dir/crtbegin_so.o etc.
+        // Do NOT use the global `zig build --libc` flag: it propagates into
+        // dependency sub-builds (e.g. uucode's native host tool
+        // uucode_generate) and breaks them with libc parse errors.
+        if (b.graph.environ_map.get("ANDROID_NDK_LIBC_FILE")) |libc_file| {
+            lib.setLibCFile(.{ .cwd_relative = libc_file });
+        }
+    }
+
     addNativeAudioDependencies(b, module, target, macos_sdk_path);
     addYogaDependencies(b, module);
 
