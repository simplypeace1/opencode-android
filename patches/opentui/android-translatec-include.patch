diff --git a/packages/core/src/zig/build.zig b/packages/core/src/zig/build.zig
index ed85ddf..191978a 100644
--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -411,6 +411,27 @@ fn addTranslatedCImports(
         .optimize = optimize,
     });
     miniaudio_translate.addIncludePath(b.path("."));
+
+    // On Android, Zig bundles glibc/musl headers but not bionic. translate-c
+    // needs the NDK sysroot include dir to resolve pthread.h/math.h.
+    if (b.graph.environ_map.get("ANDROID_NDK_HOME")) |ndk_home| {
+        const sysroot_include = b.pathJoin(&.{ ndk_home, "toolchains", "llvm", "prebuilt", "linux-x86_64", "sysroot", "usr", "include" });
+        miniaudio_translate.addSystemIncludePath(.{ .cwd_relative = sysroot_include });
+        // Arch-specific bionic headers (asm/ etc.) live in the triple subdir;
+        // clang adds it automatically, translate-c needs it explicitly.
+        const arch_triple = switch (target.result.cpu.arch) {
+            .aarch64 => "aarch64-linux-android",
+            .arm => "arm-linux-androideabi",
+            .x86 => "i686-linux-android",
+            .x86_64 => "x86_64-linux-android",
+            else => null,
+        };
+        if (arch_triple) |triple| {
+            const triple_include = b.pathJoin(&.{ sysroot_include, triple });
+            miniaudio_translate.addSystemIncludePath(.{ .cwd_relative = triple_include });
+        }
+    }
+
     module.addImport("miniaudio", miniaudio_translate.createModule());
 
     const yoga_dep = b.dependency("yoga", .{});
