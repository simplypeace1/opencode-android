+// NAPI bigint functions treat each word as 64 bits. On 64-bit platforms
+// JSBigInt::Digit is uint64_t and each word is one digit; on 32-bit
+// platforms (JSVALUE32_64, e.g. armeabi-v7a) JSBigInt::Digit is uint32_t
+// so two little-endian digits make up one 64-bit NAPI word. The code below
+// handles both layouts.
+static_assert(sizeof(JSBigInt::Digit) == sizeof(uint32_t) || sizeof(JSBigInt::Digit) == sizeof(uint64_t), "Unsupported JSBigInt::Digit size for NAPI bigint functions");
 #if USE(BIGINT32)
 #error All NAPI bigint functions assume that BIGINT32 is disabled
 #endif
 
+// Reconstruct a 64-bit value from the (up to two) least-significant
+// little-endian digits of a JSBigInt. On 64-bit platforms one digit holds
+// the whole 64-bit value; on 32-bit platforms the value spans two digits.
+static uint64_t bigIntDigitsToUInt64(JSC::JSBigInt* bigint, unsigned& digitsConsumed)
+{
+    unsigned length = bigint->length();
+    uint64_t result = 0;
+    if (length > 0)
+        result = bigint->digit(0);
+    if constexpr (sizeof(JSBigInt::Digit) == sizeof(uint32_t)) {
+        if (length > 1)
+            result |= (static_cast<uint64_t>(bigint->digit(1)) << 32);
+        digitsConsumed = std::min<unsigned>(length, 2);
+    } else {
+        digitsConsumed = std::min<unsigned>(length, 1);
+    }
+    return result;
+}
+
+// Number of NAPI (64-bit) words needed to represent a JSBigInt. On 32-bit
+// platforms each NAPI word is made of two 32-bit digits, so round up.
+static size_t bigIntWordCount(JSC::JSBigInt* bigint)
+{
+    size_t length = bigint->length();
+    if constexpr (sizeof(JSBigInt::Digit) == sizeof(uint32_t))
+        return (length + 1) / 2;
+    else
+        return length;
+}
+
+// Get NAPI word i from a JSBigInt. On 64-bit it is the i-th digit; on
+// 32-bit it is digits (2i) and (2i+1) combined.
+static uint64_t bigIntWord(JSC::JSBigInt* bigint, size_t i)
+{
+    if constexpr (sizeof(JSBigInt::Digit) == sizeof(uint64_t)) {
+        return bigint->digit(i);
+    } else {
+        uint64_t low = bigint->digit(2 * i);
+        if (2 * i + 1 < bigint->length())
+            return low | (static_cast<uint64_t>(bigint->digit(2 * i + 1)) << 32);
+        return low;
+    }
+}
+
+// Number of JSBigInt digits needed to store NAPI words. On 64-bit one digit
+// per word; on 32-bit two digits per word. The caller trims trailing zero
+// NAPI words first, but the most significant word's high 32 bits may still
+// be zero, in which case the most significant 32-bit digit is omitted.
+static size_t bigIntWordCountToDigits(size_t word_count, const uint64_t* words)
+{
+    if constexpr (sizeof(JSBigInt::Digit) == sizeof(uint64_t))
+        return word_count;
+    size_t digitCount = word_count * 2;
+    if (word_count > 0 && (words[word_count - 1] >> 32) == 0)
+        digitCount -= 1;
+    return digitCount;
+}
