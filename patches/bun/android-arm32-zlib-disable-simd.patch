diff --git a/deflate.c b/deflate.c
index d861faf..839790d 100644
--- a/deflate.c
+++ b/deflate.c
@@ -146,7 +146,13 @@ static uint32_t hash_func(deflate_state *s, void* str) {
 
 #else
 
+#if defined(__arm__) || defined(__thumb__) || defined(_M_ARM)
+static uint32_t hash_func(deflate_state *s, void* str) {
+    return crc32(0, (const unsigned char *)str, 4) & s->hash_mask;
+}
+#else
 #error "Only 64-bit Intel and ARM architectures are supported"
+#endif
 
 #endif
 
@@ -1349,6 +1355,25 @@ static void fill_window(deflate_state *s)
                 q++;
             }
 
+#else
+
+            /* Generic 32-bit fallback (standard zlib scalar loops). */
+            p = &s->head[n];
+            do {
+                m = *--p;
+                *p = (Pos)(m >= wsize ? m - wsize : NIL);
+            } while (--n);
+
+            n = wsize;
+            p = &s->prev[n];
+            do {
+                m = *--p;
+                *p = (Pos)(m >= wsize ? m - wsize : NIL);
+                /* If n is not on any hash chain, prev[n] is garbage but
+                 * its value will never be used.
+                 */
+            } while (--n);
+
 #endif
             more += wsize;
         }
