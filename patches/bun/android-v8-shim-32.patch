 // TODO: write a script to generate this struct. ideally it wouldn't even need to be committed to source.
-const V8API = if (!bun.Environment.isWindows) struct {
+// The V8 compatibility shim is only built under JSVALUE64 (64-bit). On 32-bit
+// Android (armeabi-v7a) the shim is excluded from the build, so referencing
+// these extern symbols would cause link-time undefined symbols. Keep the struct
+// empty there so fixDeadCodeElimination() has nothing to retain.
+const V8API = if (!bun.Environment.isWindows and
+    !(bun.Environment.isAndroid and !bun.Environment.isAarch64)) struct {
     pub extern fn _ZN2v87Isolate10GetCurrentEv() *anyopaque;
