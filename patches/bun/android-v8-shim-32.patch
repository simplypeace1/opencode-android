--- a/cmake/targets/BuildBun.cmake
+++ b/cmake/targets/BuildBun.cmake
@@ -609,6 +609,16 @@ set(BUN_USOCKETS_SOURCE ${CWD}/packages/bun-usockets)
 absolute_sources(BUN_CXX_SOURCES ${CWD}/cmake/CxxSources.txt)
 absolute_sources(BUN_C_SOURCES ${CWD}/cmake/CSources.txt)
 
+# Android 32-bit (armeabi-v7a / JSVALUE32_64): exclude the V8 compatibility shim.
+# The shim emulates V8's 64-bit tagged-pointer ABI (Smi packed in the upper 32
+# bits of uintptr_t, fixed Map/HandleScope/EscapableHandleScope byte sizes matching
+# real_v8::internal::Internals) and only compiles under USE(JSVALUE64). Real V8
+# dropped 32-bit support, so on 32-bit the shim is unusable; node:v8 stays a
+# notimpl stub and the NAPI layer does not link V8 symbols there.
+if(ANDROID AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+  list(FILTER BUN_CXX_SOURCES EXCLUDE REGEX ".*/bindings/v8/.*\\.cpp$")
+endif()
+
 if(WIN32)
   list(APPEND BUN_CXX_SOURCES ${CWD}/src/bun.js/bindings/windows/rescle.cpp)
   list(APPEND BUN_CXX_SOURCES ${CWD}/src/bun.js/bindings/windows/rescle-binding.cpp)
